# Copia este archivo a ".env" para correr el proyecto en tu máquina.
# En Render, estas mismas variables se configuran en el panel del servicio (no en un archivo).

# Connection string de tu base en Neon (Settings → Connection string en neon.tech).
DATABASE_URL=postgres://usuario:password@ep-xxxx.neon.tech/neondb?sslmode=require

# Contraseña única para entrar al panel.
APP_PASSWORD=elige-una-contraseña-segura

# Clave usada para firmar la cookie de sesión (cualquier texto largo y aleatorio).
SESSION_SECRET=genera-un-texto-largo-y-aleatorio

# Link para compartir del Excel en OneDrive/SharePoint (botón "Abrir en la planilla").
EXCEL_SHARE_LINK=https://achs-my.sharepoint.com/:x:/g/personal/mamonsalvec_achs_cl/IQA1CZTTb18xSqwChybcBWOZAWKtHA_z1Zf_RnipwUrT5-0?e=sjkODq

PORT=3000
NODE_ENV=production
